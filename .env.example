# Required for owner bootstrap. Keep the actual value in Sites runtime secrets.
ADMIN_OWNER_EMAIL=

# Required to activate booking confirmations; use a sending-only Resend key.
RESEND_API_KEY=

# Single sender mailbox on a domain verified in Resend. Friendly name is optional.
BOOKING_EMAIL_FROM=

# Optional single monitored reply mailbox.
BOOKING_EMAIL_REPLY_TO=
