# Läggs in i Vercel under Project Settings -> Environment Variables. Aldrig i koden.

# Supabase: Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Hemlig nyckel. Får bara finnas i Vercel, aldrig i webbläsaren eller i chatten.
SUPABASE_SERVICE_ROLE_KEY=

# Den e-postadress som blir ägarkonto första gången den loggar in. Kontot måste ha bekräftad e-post.
ADMIN_OWNER_EMAIL=

# Valfritt: bokningsbekräftelser via Resend (samma som i ChatGPT:s version).
RESEND_API_KEY=
BOOKING_EMAIL_FROM=
BOOKING_EMAIL_REPLY_TO=

# Hemsidans adress, t.ex. https://www.albertno485.com
APP_ORIGIN=
